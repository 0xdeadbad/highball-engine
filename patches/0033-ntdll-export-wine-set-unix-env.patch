ntdll: Export __wine_set_unix_env to set a host environment variable.

wineopenxr passes the Vulkan device extensions the OpenXR runtime requires to
winevulkan's host side through a host environment variable, set from the PE side
with this export.

From Proton (ValveSoftware/wine 1d4a019a8c6, a Proton HACK). Ported: CrossOver
26.3 has no steamclient trampolines, so the new unix call sits after
system_time_precise and before pe_module_loaded in the enum and in both call
tables, keeping their order the same.

diff --git a/dlls/ntdll/env.c b/dlls/ntdll/env.c
index dd4f9c2..08b2eb4 100644
--- a/dlls/ntdll/env.c
+++ b/dlls/ntdll/env.c
@@ -730,3 +730,17 @@ void init_user_process_params(void)
     set_wow64_environment( &new_params->Environment );
     new_params->EnvironmentSize = RtlSizeHeap( GetProcessHeap(), 0, new_params->Environment );
 }
+
+
+/**********************************************************************
+ *      __wine_set_unix_env
+ */
+NTSTATUS WINAPI __wine_set_unix_env( const char *var, const char *val )
+{
+    struct wine_set_unix_env_params params =
+    {
+        .name = var, .val = val
+    };
+
+    return WINE_UNIX_CALL( unix___wine_set_unix_env, &params );
+}
